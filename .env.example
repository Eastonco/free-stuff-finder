# Copy to .env and fill in. .env is gitignored.

# --- AI classification ---
ANTHROPIC_API_KEY=sk-ant-...          # Claude Haiku (default classifier; also the admin "GET" pickup draft)

# Optional: classify with jev via OpenRouter's Decisions API instead (text only, no photo).
# OPENROUTER_API_KEY=sk-or-...
# CLASSIFIER=openrouter               # default: anthropic
# OPENROUTER_MODEL=~typesafe/jev-latest
# OPENROUTER_WANT_THRESHOLD=0.5       # jev returns a probability; at/above this is a 'want'

# --- Web app (required) ---
INVITE_CODE=pick-something-friends-only      # friends enter this to create a profile
ADMIN_PASSWORD=pick-a-strong-admin-password  # Basic-Auth password for /admin (user: admin)


# --- Postgres ---
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=craigslist

# --- Notifications ---
# ntfy: nothing required for the public server (https://ntfy.sh).
# Self-host? point at it here:
# NTFY_SERVER=https://ntfy.example.com

# Twilio (only needed if any user picks the "sms" channel)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1XXXXXXXXXX
